<!-- =========================================
     SERVICES HERO
========================================= -->

<section class="services-hero">

    <div class="hero-grid"></div>

    <div class="hero-glow glow-left"></div>
    <div class="hero-glow glow-right"></div>

    <div class="container services-hero-wrapper">

        <div class="services-content">

            <h1>
                Smart Software Solutions
                <span>for Growing Businesses</span>
            </h1>

            <p>
                Brothers Light delivers custom software, ERP, HRMS, CRM,
                AI, mobile apps, task management, and cloud solutions
                to simplify business operations and improve productivity.
            </p>

        </div>


        <div class="services-image">

            <img
                src="/images/servicepage.jpg"
                alt="Software development and business technology solutions by Brothers Light"
                loading="eager"
            >

            <div class="floating-card card1">
                Business Automation
            </div>

            <div class="floating-card card2">
                HRMS
            </div>

            <div class="floating-card card3">
                AI Solutions
            </div>

            <div class="floating-card card4">
                Mobile Apps
            </div>

            <div class="floating-card card5">
                CRM
            </div>

            <div class="floating-card card6">
                Cloud Solutions
            </div>

        </div>

    </div>

</section>


<!-- =========================================
     SOFTWARE SOLUTIONS
========================================= -->

<section class="software-section" id="software-solutions">
    <div class="container">

        <div class="software-heading">
            <h2>Our Software Solutions</h2>
            <p>
                Business-focused software development solutions
                designed around your requirements.
            </p>
        </div>

        <div class="software-grid">

            <!-- CUSTOM SOFTWARE -->
            <article class="service-card">
                <img src="/images/custom-software.jpg"
                     alt="Custom software development"
                     loading="lazy">

                <h3>Custom Software Development</h3>
                <p>
                    Custom business software and web applications designed
                    to automate workflows and meet your business needs.
                </p>

                <a href="/custom-software-development" class="service-link">
                    Learn More <i class="fas fa-arrow-right"></i>
                </a>
            </article>

            <!-- ERP SOFTWARE -->
            <article class="service-card">
                <img src="/images/erp.jpg"
                     alt="ERP software development"
                     loading="lazy">

                <h3>ERP Software Development</h3>
                <p>
                    Manage inventory, sales, finance, and daily business
                    operations through integrated ERP software.
                </p>

                <a href="/erp-software" class="service-link">
                    Learn More <i class="fas fa-arrow-right"></i>
                </a>
            </article>

            <!-- HRMS SOFTWARE -->
            <article class="service-card">
                <img src="/images/hrms.jpg"
                     alt="Human Resource Management System"
                     loading="lazy">

                <h3>HRMS Software</h3>
                <p>
                    Simplify employee records, attendance, leave management,
                    and HR administration with HRMS solutions.
                </p>

                <a href="/hrms-software" class="service-link">
                    Learn More <i class="fas fa-arrow-right"></i>
                </a>
            </article>

            <!-- CRM SOFTWARE -->
            <article class="service-card">
                <img src="/images/crm.jpg"
                     alt="Customer Relationship Management software"
                     loading="lazy">

                <h3>CRM Software Development</h3>
                <p>
                    Manage customer relationships, leads, sales pipelines,
                    and follow-ups with customized CRM software.
                </p>

                <a href="/crm-software" class="service-link">
                    Learn More <i class="fas fa-arrow-right"></i>
                </a>
            </article>

            <!-- AI SOLUTIONS -->
            <article class="service-card">
                <img src="/images/ai.jpg"
                     alt="Artificial intelligence solutions"
                     loading="lazy">

                <h3>AI Solutions</h3>
                <p>
                    Use AI-powered applications and automation to simplify
                    workflows and support business decisions.
                </p>

                <a href="/ai-solutions" class="service-link">
                    Learn More <i class="fas fa-arrow-right"></i>
                </a>
            </article>

            <!-- MOBILE APP DEVELOPMENT -->
            <article class="service-card">
                <img src="/images/mobile.jpg"
                     alt="Android and iOS mobile app development"
                     loading="lazy">

                <h3>Mobile App Development</h3>
                <p>
                    Develop user-friendly Android and iOS applications
                    for your business, employees, and customers.
                </p>

                <a href="/mobile-app-development" class="service-link">
                    Learn More <i class="fas fa-arrow-right"></i>
                </a>
            </article>

            <!-- TASK MANAGEMENT -->
            <article class="service-card">
                <img src="/images/task.jpg"
                     alt="Task and project management software"
                     loading="lazy">

                <h3>Task Management Software</h3>
                <p>
                    Organize tasks, assign responsibilities, track deadlines,
                    and improve team collaboration.
                </p>

                <a href="/task-management-software" class="service-link">
                    Learn More <i class="fas fa-arrow-right"></i>
                </a>
            </article>

            <!-- CLOUD SOLUTIONS -->
            <article class="service-card">
                <img src="/images/cloud.jpg"
                     alt="Cloud solutions and application deployment"
                     loading="lazy">

                <h3>Cloud Solutions</h3>
                <p>
                    Deploy and manage business applications with cloud hosting,
                    server configuration, and backup solutions.
                </p>

                <a href="/cloud-solutions" class="service-link">
                    Learn More <i class="fas fa-arrow-right"></i>
                </a>
            </article>

        </div>
    </div>
</section>




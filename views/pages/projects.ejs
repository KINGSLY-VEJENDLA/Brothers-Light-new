         PROJECTS
    ========================================== -->

    <section class="projects-section light-section">

        <div class="container">


            <div class="projects-heading">
                <span>OUR WORK</span>
                <h2>Selected Projects</h2>
                <p>Websites and business systems built by Brothers Light.</p>
            </div>

            <div class="projects-grid">
                <article class="project-card">
                    <div class="project-image">
                        <img
                            src="/images/telugu-samskruthi-project.png"
                            alt="Telugu Samskruthi online learning platform"
                            loading="lazy">
                    </div>
                    <div class="project-content">
                        <span class="project-category">LEARNING PLATFORM</span>
                        <h3>Telugu Samskruthi</h3>
                        <p>Online Telugu language and cultural learning for students and families worldwide.</p>
                        <div class="project-tech"><span>Education · Website</span></div>
                        <a class="project-link" href="https://telugusamskruthi.com/" target="_blank" rel="noopener noreferrer">
                            Visit Website <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                        </a>
                    </div>
                </article>

                <article class="project-card">
                    <div class="project-image">
                        <img
                            src="/images/cure-health-24-project.png"
                            alt="Cure Health 24 healthcare website"
                            loading="lazy">
                    </div>
                    <div class="project-content">
                        <span class="project-category">HEALTHCARE</span>
                        <h3>Cure Health 24</h3>
                        <p>A healthcare website and telemedicine platform connecting people with convenient care.</p>
                        <div class="project-tech"><span>Healthcare · Telemedicine</span></div>
                        <a class="project-link" href="https://curehealth24.com/" target="_blank" rel="noopener noreferrer">
                            Visit Website <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                        </a>
                    </div>
                </article>

                <article class="project-card">
                    <div class="project-image">
                        <img
                            src="https://www.yuganrealestate.com/images/services-hero.jpg"
                            alt="Yugan Real Estate property services"
                            loading="lazy">
                    </div>
                    <div class="project-content">
                        <span class="project-category">REAL ESTATE</span>
                        <h3>Yugan Real Estate</h3>
                        <p>A real estate website helping buyers explore property services and local expertise.</p>
                        <div class="project-tech"><span>Real Estate · Website</span></div>
                        <a class="project-link" href="https://www.yuganrealestate.com/" target="_blank" rel="noopener noreferrer">
                            Visit Website <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                        </a>
                    </div>
                </article>

                <article class="project-card">
                    <div class="project-image project-image-placeholder project-image-crm" role="img" aria-label="Brothers Light Blog CRM project artwork">
                        <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                        <span>Brothers Light</span>
                        <strong>Blog CRM</strong>
                    </div>
                    <div class="project-content">
                        <span class="project-category">CONTENT MANAGEMENT</span>
                        <h3>Brothers Light Blog CRM</h3>
                        <p>A custom CRM for creating, editing, publishing, and managing blog content.</p>
                        <div class="project-tech"><span>Custom Software · Blog CMS</span></div>
                        <span class="project-link project-link-unavailable">Deployment link available on request</span>
                    </div>
                </article>

                <article class="project-card">
                    <div class="project-image">
                        <img
                            src="/images/erp.jpg"
                            alt="Business dashboard artwork for Brothers Light ERP"
                            loading="lazy">
                    </div>
                    <div class="project-content">
                        <span class="project-category">BUSINESS OPERATIONS</span>
                        <h3>Brothers Light ERP</h3>
                        <p>A custom ERP and invoicing system for business operations, quotations, and invoices.</p>
                        <div class="project-tech"><span>Custom Software · ERP</span></div>
                        <span class="project-link project-link-unavailable">Deployment link available on request</span>
                    </div>
                </article>
            </div>


        </div>

    </section>




                    <div class="project-number">
                        01
                    </div>

                </div>


                <div class="project-content">

                    <span class="project-category">
                        CULTURE • WEBSITE DEVELOPMENT
                    </span>

                    <h3>
                        Telugu Samskruthi
                    </h3>

                    <p>
                        A digital platform focused on Telugu culture,
                        heritage, traditions and cultural content,
                        designed to provide an engaging online
                        experience for its audience.
                    </p>


                    <div class="project-tech">

                        <span>Web Development</span>

                        <span>Responsive Design</span>

                        <span>UI/UX</span>

                    </div>


                    <a
                        href="#"
                        class="project-link">

                        View Project

                        <i class="fa-solid fa-arrow-up-right-from-square"></i>

                    </a>

                </div>

            </article>



            <!-- =================================
                 PROJECT 2
            ================================== -->

            <article class="project-card project-card-reverse">

                <div class="project-image">

                    <img
                        src="/images/cure-health-24-project.png"
                        alt="Cure Health 24 healthcare website developed by Brothers Light">

                    <div class="project-number">
                        02
                    </div>

                </div>


                <div class="project-content">

                    <span class="project-category">
                        HEALTHCARE • WEB APPLICATION
                    </span>

                    <h3>
                        Cure Health 24
                    </h3>

                    <p>
                        A healthcare-focused digital platform designed
                        to provide users with convenient access to
                        healthcare information, services and
                        telemedicine functionality.
                    </p>


                    <div class="project-tech">

                        <span>Web Development</span>

                        <span>Telemedicine</span>

                        <span>Responsive Design</span>

                    </div>


                    <a
                        href="#"
                        class="project-link">

                        View Project

                        <i class="fa-solid fa-arrow-up-right-from-square"></i>

                    </a>

                </div>

            </article>


        </div>


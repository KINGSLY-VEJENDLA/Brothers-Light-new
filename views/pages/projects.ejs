    <!-- =========================================
         PROJECT HERO
    ========================================== -->

    <section class="projects-hero">

        <div class="projects-hero-grid"></div>

        <div class="projects-glow projects-glow-1"></div>

        <div class="projects-glow projects-glow-2"></div>


        <div class="container">

            <div class="projects-hero-content">

                <span class="projects-tag">
                    OUR WORK
                </span>

                <h1>
                    Projects That
                    <span>Make an Impact</span>
                </h1>

                <p>
                    Explore digital solutions designed and developed
                    by Brothers Light to solve real business and
                    customer needs.
                </p>

            </div>

        </div>

    </section>




<div class="contact-form-wrapper">

    <div class="contact-form-header">
        <span>GET IN TOUCH</span>

        <h2>
            Tell Us What
            <span>You Need</span>
        </h2>

        <p>
            Share a few details about your project.
            Our team will get back to you shortly.
        </p>
    </div>


    <form action="/send-enquiry" method="POST" class="contact-form">

        <div class="form-row">

            <div class="form-group">

                <label for="name">
                    Your Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Enter your name"
                    required
                >

            </div>


            <div class="form-group">

                <label for="phone">
                    Phone Number
                </label>

                <input
                    type="tel"
                    id="phone"
                    name="phone"
                    placeholder="Enter your phone number"
                    required
                >

            </div>

        </div>


        <div class="form-group">

            <label for="email">
                Email Address
            </label>

            <input
                type="email"
                id="email"
                name="email"
                placeholder="Enter your email"
                required
            >

        </div>


        <div class="form-group">

            <label>
                What are you looking for?
            </label>

            <div class="option-buttons">

                <label class="option">
                    <input
                        type="checkbox"
                        name="requirement"
                        value="Custom Software"
                    >
                    <span>Custom Software</span>
                </label>


                <label class="option">
                    <input
                        type="checkbox"
                        name="requirement"
                        value="ERP"
                    >
                    <span>ERP</span>
                </label>


                <label class="option">
                    <input
                        type="checkbox"
                        name="requirement"
                        value="HRMS"
                    >
                    <span>HRMS</span>
                </label>


                <label class="option">
                    <input
                        type="checkbox"
                        name="requirement"
                        value="Mobile App"
                    >
                    <span>Mobile App</span>
                </label>


                <label class="option">
                    <input
                        type="checkbox"
                        name="requirement"
                        value="Cloud Solutions"
                    >
                    <span>Cloud</span>
                </label>


                <label class="option">
                    <input
                        type="checkbox"
                        name="requirement"
                        value="Maintenance"
                    >
                    <span>Maintenance</span>
                </label>

            </div>

        </div>


        <div class="form-group">

            <label for="message">
                Tell us about your requirement
            </label>

            <textarea
                id="message"
                name="message"
                rows="4"
                placeholder="Briefly describe what you need..."
            ></textarea>

        </div>


        <button type="submit" class="contact-submit">

            Send Enquiry

            <i class="fa-solid fa-arrow-right"></i>

        </button>

    </form>

</div>

</div>

</section>


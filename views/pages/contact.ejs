<body>

<%- include("../partials/navbar") %>

<!-- ===================================
Hero
=================================== -->

<section class="contact-hero dark-section">

<div class="hero-grid"></div>

<div class="hero-glow glow-left"></div>
<div class="hero-glow glow-right"></div>

<div class="container contact-hero-wrapper">

<div class="contact-content">

<!-- <span class="section-tag">

CONTACT US

</span> -->

<h1>

Let's Build

<span>Powerful Software</span>

Together.

</h1>

<p>

Whether you need ERP, HRMS, Mobile Apps,
Custom Software or AI Solutions,
our experts are ready to help.

</p>

<!-- <div class="hero-buttons">

<a href="#project" class="btn-primary">

Start Your Project

</a>

<a href="#contact" class="btn-outline">

Schedule Meeting

</a>

</div> -->

</div>

<div class="contact-form-wrapper">

    <div class="contact-form-header">
        <span>GET IN TOUCH</span>

        <h2>
            Tell Us What
            <span>You Need</span>
        </h2>

        <p>
            Share a few details about your project.
            Our team will get back to you shortly.
        </p>
    </div>

  
    
    <form action="/send-enquiry" method="POST" class="contact-form">

        <div class="form-row">

            <div class="form-group">

                <label for="name">
                    Your Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Enter your name"
                    required
                >

            </div>


            <div class="form-group">

                <label for="phone">
                    Phone Number
                </label>

                <input
                    type="tel"
                    id="phone"
                    name="phone"
                    placeholder="Enter your phone number"
                    required
                >

            </div>

        </div>


        <div class="form-group">

            <label for="email">
                Email Address
            </label>

            <input
                type="email"
                id="email"
                name="email"
                placeholder="Enter your email"
                required
            >

        </div>


        <div class="form-group">

            <label>
                What are you looking for?
            </label>

            <div class="option-buttons">

                <label class="option">
                    <input
                        type="checkbox"
                        name="requirement"
                        value="Custom Software"
                    >
                    <span>Custom Software</span>
                </label>


                <label class="option">
                    <input
                        type="checkbox"
                        name="requirement"
                        value="ERP"
                    >
                    <span>ERP</span>
                </label>


                <label class="option">
                    <input
                        type="checkbox"
                        name="requirement"
                        value="HRMS"
                    >
                    <span>HRMS</span>
                </label>


                <label class="option">
                    <input
                        type="checkbox"
                        name="requirement"
                        value="Mobile App"
                    >
                    <span>Mobile App</span>
                </label>


                <label class="option">
                    <input
                        type="checkbox"
                        name="requirement"
                        value="Cloud Solutions"
                    >
                    <span>Cloud</span>
                </label>


                <label class="option">
                    <input
                        type="checkbox"
                        name="requirement"
                        value="Maintenance"
                    >
                    <span>Maintenance</span>
                </label>

            </div>

        </div>


        <div class="form-group">

            <label for="message">
                Tell us about your requirement
            </label>

            <textarea
                id="message"
                name="message"
                rows="4"
                placeholder="Briefly describe what you need..."
            ></textarea>

        </div>


        <button type="submit" class="contact-submit">

            Send Enquiry

            <i class="fa-solid fa-arrow-right"></i>

        </button>

    </form>

</div>

</div>

</section>

<section class="global-presence light-section">

    <div class="global-map-grid"></div>

    <div class="global-header">

            <span class="global-tag">
                GLOBAL PRESENCE
            </span>

            <h2>
                Building Solutions
                <span>Worldwide</span>
            </h2>

            <p>
                We help businesses across different markets build,
                manage and scale powerful digital solutions.
            </p>

        </div>
    <div class="container">

        

        <div class="global-map-wrapper">


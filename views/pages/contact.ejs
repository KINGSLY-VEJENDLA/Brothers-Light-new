            </div>

            <div class="map-location usa">
                <span></span>
                <div>
                    <strong>USA</strong>
                    <small>United States</small>
                </div>
            </div>

            <div class="map-location uk">
                <span></span>
                <div>
                    <strong>UK</strong>
                    <small>United Kingdom</small>
                </div>
            </div>

            <!-- <div class="map-location uae">
                <span></span>

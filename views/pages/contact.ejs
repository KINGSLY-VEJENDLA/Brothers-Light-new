                </div>
            </div> -->

        </div>
       

    </div>
    <!-- ===================================
         CONTACT INFORMATION CARDS
    =================================== -->
    <div class="container">

        <div class="global-contact-cards">

            <!-- EMAIL CARD -->
            <a href="mailto:info@brotherslight.in" class="global-contact-card">

                <div class="contact-card-top">

                    <div class="contact-card-icon">
                        <i class="fa-solid fa-envelope"></i>
                    </div>

                    <span class="contact-card-badge email-badge">
                        <span class="pulse-dot"></span> Active Support
                    </span>

                </div>

                <div class="contact-card-content">

                    <span class="contact-label">Official Email</span>

                    <h3 class="contact-value">
                        info@brotherslight.in
                    </h3>

                    <p class="contact-subtext">
                        Online 24/7 • Fast Response
                    </p>

                </div>

                <div class="contact-card-action">
                    <span>Send an email</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>

            </a>


            <!-- INDIA CARD -->
            <a href="tel:+919100739675" class="global-contact-card">

                <div class="contact-card-top">

                    <div class="contact-card-icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>

                    <span class="contact-card-badge">
                        India HQ
                    </span>

                </div>

                <div class="contact-card-content">

                    <span class="contact-label">Hyderabad Office</span>

                    <h3 class="contact-value">
                        +91 91007 39675
                    </h3>

                    <p class="contact-subtext">
                        Hyderabad, Telangana, India
                    </p>

                </div>

                <div class="contact-card-action">
                    <span>Call office</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>

            </a>


            <!-- USA CARD -->
            <a href="tel:+15014203185" class="global-contact-card">

                <div class="contact-card-top">

                    <div class="contact-card-icon">
                        <i class="fa-solid fa-globe"></i>
                    </div>

                    <span class="contact-card-badge">
                        United States
                    </span>

                </div>

                <div class="contact-card-content">

                    <span class="contact-label">USA Office</span>

                    <h3 class="contact-value">
                        +1 (501) 420-3185
                    </h3>

                    <p class="contact-subtext">
                        Arkansas, United States
                    </p>

                </div>

                <div class="contact-card-action">
                    <span>Call office</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>

            </a>

        </div>

    </div>

</section>



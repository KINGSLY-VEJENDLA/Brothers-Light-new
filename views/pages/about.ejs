                </div>

            </div>

            <div class="hero-card card-three">

                <i class="fa-solid fa-chart-line"></i>

                <div>

                    <h4>Business Growth</h4>

                    <span>Data Driven Solutions</span>

                </div>

            </div>

        </div>

    </div>

</section>

<section class="vision light-section">

    <div class="vision-header">

            <!-- <span class="section-tag">
                OUR PURPOSE
            </span> -->

            <h2 class="section-title">
                Driven by Innovation.<br>
                Focused on Your Success.
            </h2>

            <!-- <p class="section-text">
                Our mission is to empower businesses through cutting-edge
                software solutions that simplify operations, increase
                productivity, and accelerate digital transformation.
            </p> -->

        </div>


    <div class="container">

        
        <div class="vision-grid">


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/seo') %>
    <% if (blogJsonLd) { %><script type="application/ld+json"><%- blogJsonLd %></script><% } %>
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/blogs.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="bl-blog-page bl-article-page">
        <% if (!blog) { %>
            <section class="bl-blog-container bl-blog-state bl-article-state" <%= apiError ? 'role="status"' : '' %>>
                <span class="bl-blog-state-icon" aria-hidden="true"><i class="fa-solid <%= apiError ? 'fa-cloud-arrow-down' : 'fa-file-circle-question' %>"></i></span>
                <h1><%= apiError ? "Article temporarily unavailable" : "Article not found" %></h1>
                <p><%= apiError ? "We could not connect to the Brothers Light Blog service. Please try again shortly." : "This article may have been unpublished or the URL may be incorrect." %></p>
                <a class="bl-blog-button" href="/blogs"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to blogs</a>
            </section>
        <% } else { %>
            <article class="bl-article">
                <div class="bl-article-top">
                    <nav class="bl-article-breadcrumb" aria-label="Breadcrumb">
                        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/blogs">Blog</a><span aria-hidden="true">/</span><span aria-current="page"><%= blog.title %></span>
                    </nav>
                    <% if (blog.category) { %><p class="bl-blog-eyebrow"><%= blog.category %></p><% } %>
                    <h1><%= blog.title %></h1>
                    <% if (blog.excerpt) { %><p class="bl-article-excerpt"><%= blog.excerpt %></p><% } %>
                    <div class="bl-article-byline">
                        <span>By <strong><%= blog.author_name || "Brothers Light" %></strong></span>
                        <% if (dateIso(blog.published_at)) { %><span aria-hidden="true">·</span><time datetime="<%= dateIso(blog.published_at) %>"><%= dateDisplay(blog.published_at) %></time><% } %>
                    </div>
                </div>
                <img class="bl-article-featured" src="<%= blog.featured_image_url || '/images/blog-image-fallback.svg' %>" alt="<%= blog.title %>" fetchpriority="high" onerror="this.onerror=null;this.src='/images/blog-image-fallback.svg';">
                <div class="bl-article-body"><%- articleContent %></div>
                <% if (blog.tags) { %><p class="bl-article-tags"><strong>Topics:</strong> <%= blog.tags %></p><% } %>
                <a class="bl-article-back" href="/blogs"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to all articles</a>
            </article>

            <% if (related.length) { %>
                <section class="bl-blog-container bl-related" aria-labelledby="bl-related-title">
                    <div class="bl-blog-heading">
                        <div><p class="bl-blog-eyebrow">KEEP EXPLORING</p><h2 id="bl-related-title">Related articles</h2></div>
                    </div>
                    <div class="bl-blog-grid">
                        <% related.forEach(function(item) { %>
                            <article class="bl-blog-card">
                                <a class="bl-blog-card-image" href="/blogs/<%= encodeURIComponent(item.slug) %>" aria-label="Read <%= item.title %>">
                                    <% if (item.featured_image_url) { %><img src="<%= item.featured_image_url %>" alt="<%= item.title %>" loading="lazy" onerror="this.onerror=null;this.src='/images/blog-image-fallback.svg';"><% } else { %><img src="/images/blog-image-fallback.svg" alt="<%= item.title %>"><% } %>
                                </a>
                                <div class="bl-blog-card-body">
                                    <div class="bl-blog-meta">
                                        <% if (item.category) { %><span><%= item.category %></span><% } %>
                                        <% if (dateIso(item.published_at)) { %><time datetime="<%= dateIso(item.published_at) %>"><%= dateDisplay(item.published_at) %></time><% } %>
                                    </div>
                                    <h3><a href="/blogs/<%= encodeURIComponent(item.slug) %>"><%= item.title %></a></h3>
                                    <p><%= item.excerpt || "" %></p>
                                    <a class="bl-blog-readmore" href="/blogs/<%= encodeURIComponent(item.slug) %>">Read article <span aria-hidden="true">→</span></a>
                                </div>
                            </article>
                        <% }) %>
                    </div>
                </section>
            <% } %>
        <% } %>
    </main>

    <%- include('../partials/contact-banner') %>
    <script src="/js/navbar.js"></script>
    <script src="/js/contact-banner.js"></script>
</body>
</html>
